# MySQL connection string. Do not commit the real value to Git.
# Example: mysql://pangpang_user:strong-password@127.0.0.1:3306/pangpangshop
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Reservation inventory hold length. Defaults to 48 hours when omitted.
RESERVATION_HOLD_HOURS="48"

# Backend session signing key. Never commit the real value.
ADMIN_SESSION_SECRET="generate-a-long-random-secret"
INITIAL_ADMIN_EMAIL="owner@example.com"
INITIAL_ADMIN_PASSWORD="choose-a-long-unique-password"

# Hostinger FTP credentials used by the admin image-upload features.
# Use the server/FTP host shown in hPanel. Keep these values private.
FTP_HOST="ftp.example.com"
FTP_PORT="21"
FTP_USER="ftp-user"
FTP_PASSWORD="choose-a-strong-ftp-password"
